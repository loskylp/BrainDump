# .env.production.example
#
# Template for /opt/braindump/.env.production on the server.
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production -- it contains secrets.
#
# See process/devops/environment-contract-v1.md for full variable reference.

POSTGRES_URL=postgresql://braindump_prod:<password>@postgres:5432/braindump_prod
SESSION_SECRET=<long-random-string-minimum-64-chars>
NODE_ENV=production
APP_URL=https://braindump.nxlabs.cc
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@nxlabs.cc
