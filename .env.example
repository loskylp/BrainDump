# BrainDump -- environment variable template
#
# Copy this file to .env and fill in values for local development.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# NEVER put real secrets in this file -- it is committed as documentation only.
# See process/devops/environment-contract-v1.md for full variable reference.

# ─── Database ─────────────────────────────────────────────────────────────
# Local development: points at the postgres service in docker-compose.dev.yml.
# The docker-compose.dev.yml overrides this to use the Compose service hostname,
# so this value is used only when running the backend outside of Compose.
POSTGRES_URL=postgresql://braindump_dev:braindump_dev@localhost:5432/braindump_dev

# ─── Application ──────────────────────────────────────────────────────────
# NODE_ENV controls logging verbosity, error detail in responses, and
# whether Sequelize logs SQL queries.
# Values: development | staging | production | test
NODE_ENV=development

# Public URL of the application -- used in password reset email links.
# In development this is the Vite dev server or localhost:3000.
APP_URL=http://localhost:5173

# ─── Session ──────────────────────────────────────────────────────────────
# Secret used to sign session cookies. Any string works in development.
# Must be unique per environment and never shared between staging and production.
# In production: generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-any-value-works-in-local-dev

# ─── Email ────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER=console prints emails to stdout instead of sending them.
# Use this in development and staging.
# In production, set to the real provider name (e.g. "sendgrid", "mailgun").
EMAIL_PROVIDER=console

# API key for the email provider. Not required when EMAIL_PROVIDER=console.
# In production: obtain from the email provider dashboard.
EMAIL_API_KEY=

# Sender address used in outgoing emails (password reset, etc.).
EMAIL_FROM=noreply@example.com
